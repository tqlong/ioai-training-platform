# Development PostgreSQL is configured by docker-compose.yml and stores durable
# local author data in database `ioai` on loopback port 5432.
IOAI_DATABASE_URL=postgresql+psycopg://ioai:ioai@127.0.0.1:5432/ioai

# Browser requests normally use the same-origin Learn or Studio proxy. Direct
# local API development may use only these explicit origins; wildcard origins
# are rejected and no credentialed CORS is enabled.
IOAI_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
IOAI_ENVIRONMENT=development
API_INTERNAL_BASE=http://127.0.0.1:8000

# Destructive integration tests must use a database whose name ends in `_test`.
# scripts/backend_test.sh supplies this isolated default automatically.
IOAI_TEST_DATABASE_URL=postgresql+psycopg://ioai_test:ioai_test@127.0.0.1:5433/ioai_test
