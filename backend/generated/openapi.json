    "/api/v1/author/vocabulary": {
      "get": {
        "operationId": "list_author_vocabulary_api_v1_author_vocabulary_get",
        "parameters": [
          {
            "in": "query",
            "name": "vocabulary_type",
            "required": true,
            "schema": {
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "title": "Vocabulary Type",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          },
          {
            "in": "query",
            "name": "root_code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[A-Z][A-Z0-9_]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Root Code"
            }
          },
          {
            "in": "query",
            "name": "include_descendants",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Descendants",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
