{
  "name": "ioai-training-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Release 0 monorepo scaffold",
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "playwright test",
    "test:a11y": "bash scripts/accessibility_check.sh",
    "build": "pnpm -r run build",
    "generate:contracts": "bash scripts/generate_contracts.sh",
    "check:contracts": "bash scripts/openapi_drift_check.sh",
    "quality": "bash scripts/foundation_quality.sh",
    "quality:migration": "bash scripts/foundation_migration_check.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.55.0",
    "@types/node": "^22.20.1",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.1.9"
  }
}
